generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  address     String
  lat         Float
  lng         Float
  exchange    Boolean  @default(true)
  sellNew     Boolean  @default(false)
  price       Int?
  phone       String?
  approved    Boolean  @default(false)
  submittedBy String?
  openHours   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceHistory PriceHistory[]
  auditLogs    AuditLog[]
}

model PriceHistory {
  id        String   @id @default(cuid())
  shopId    String
  price     Int
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  shopId    String?
  details   String?
  createdAt DateTime @default(now())

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([createdAt])
}
